# Backend environment. Copy to .env for local development.
# NEVER commit a filled-in .env. All values below are secrets or environment-specific.

# SQLAlchemy URL. Local Homebrew Postgres example:
DATABASE_URL=postgresql+psycopg://localhost/media_companion

# "development" | "production"
ENV=development

# Comma-separated list of allowed frontend origins (CORS).
FRONTEND_ORIGIN=http://localhost:3000

# --- External API credentials (server-side only, never exposed to the client) ---
# TMDb: https://www.themoviedb.org/settings/api  (v3 API key)
TMDB_API_KEY=

# Google Books API key is OPTIONAL (Open Library is primary per spec §15 D1;
# basic Google Books search works without a key). Used for the Phase 6 fallback.
GOOGLE_BOOKS_API_KEY=

# Anthropic API key: https://console.anthropic.com/
# OPTIONAL and NOT required anywhere. When set, newly added items get mood_tags
# via a bounded call; when unset, add still works and mood_tags backfill later.
ANTHROPIC_API_KEY=
# Optional model override for mood-tag classification (blank = service default).
MOOD_TAGS_MODEL=

# --- LLM for free-text -> preference extraction (spec §7, §10) ---
# Provider-agnostic. "gemini" (initial) or "none" to disable the LLM entirely.
# With the LLM disabled or key-less, the deterministic fallback parser runs and
# recommendations still work. No Anthropic / paid-subscription dependency.
LLM_PROVIDER=gemini
# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# A current free-tier model; blank = service default (gemini-2.5-flash).
GEMINI_MODEL=
