# Backend environment. Copy to .env for local development.
# NEVER commit a filled-in .env. All values below are secrets or environment-specific.

# SQLAlchemy URL. Local Homebrew Postgres example:
DATABASE_URL=postgresql+psycopg://localhost/media_companion

# "development" | "production"
ENV=development

# Comma-separated list of allowed frontend origins (CORS).
FRONTEND_ORIGIN=http://localhost:3000

# --- External API credentials (server-side only, never exposed to the client) ---
# TMDb: https://www.themoviedb.org/settings/api  (v3 API key)
TMDB_API_KEY=

# Google Books API key is OPTIONAL — Open Library is primary (spec §15 D1) and
# Google Books is the fallback; basic search works without a key.
GOOGLE_BOOKS_API_KEY=

# --- LLM provider (spec §7, §10, §15 D6/D7) ---
# Provider-agnostic. "gemini" (initial) or "none" to disable the LLM entirely.
# With the LLM disabled or key-less: preference extraction uses the deterministic
# fallback parser and mood-tag classification is skipped — the app still works.
# No Anthropic / paid-subscription dependency anywhere.
LLM_PROVIDER=gemini
# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# A current free-tier model; blank = service default (gemini-3.5-flash-lite).
GEMINI_MODEL=

# --- Auth (Phase 8: authentication foundation) ---
# Required for /auth/login and /auth/register to work — signs and verifies
# JWTs. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# NEVER reuse a value from an example/doc; a guessable key lets anyone forge tokens.
JWT_SECRET_KEY=
# HMAC algorithm for signing. HS256 is fine for a single-backend deployment
# (symmetric: the same key signs and verifies).
JWT_ALGORITHM=HS256
# How long an issued token stays valid, in minutes. Default: 7 days.
JWT_EXPIRES_MINUTES=10080

# --- Legacy library claim (Phase 8.2 bootstrap, TEMPORARY) ---
# The only email allowed to call POST /admin/claim-legacy-library
# (app/api/admin.py). Leave blank to disable the endpoint entirely (the
# default — a blank value can never equal a real caller's email). Set this,
# claim the legacy rows once, then unset it (or delete the endpoint
# entirely) — it isn't meant to stay configured long-term.
LEGACY_CLAIM_ALLOWED_EMAIL=
